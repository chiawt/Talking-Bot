# Keep your token private. Copy this file to .env and edit locally.
TELEGRAM_BOT_TOKEN=
# Leave empty first, send /whoami, then set your numeric ID and restart.
TELEGRAM_ALLOWED_USER_ID=
GOOGLE_CALENDAR_ID=primary
BOT_TIMEZONE=Asia/Singapore
# Optional: voice transcription and request interpretation (paid API usage).
OPENAI_API_KEY=
# Optional: full path to ffmpeg.exe if it is not on PATH.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
